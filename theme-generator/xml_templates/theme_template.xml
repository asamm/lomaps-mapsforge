						</rule>
						<rule e="way" k="*" v="*" zoom-min="17">
							<line stroke="$color_railway_main_case" stroke-width="$railway_main_width_z17" stroke-linecap="butt" />
							<line stroke="$color_railway_main" stroke-width="${0.75 * $railway_main_width_z17}" stroke-dasharray="2,2" stroke-linecap="butt" scale="all" />
