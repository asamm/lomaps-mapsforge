					<line stroke="$opacity($color_downhill_novice, 58.2)" stroke-width="$piste_downhill_width"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="easy">
					<line stroke="$opacity($color_downhill_easy, 60)" stroke-width="$piste_downhill_width"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="intermediate">
					<line stroke="$opacity($color_downhill_intermediate, 60)" stroke-width="$piste_downhill_width"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="advanced|expert">
					<line stroke="$opacity($color_downhill_advanced, 55)" stroke-width="$piste_downhill_width"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="freeride">
					<line stroke="$opacity($color_downhill_freeride, 60)" stroke-width="$piste_downhill_width"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="~">
					<line stroke="$opacity($color_downhill_intermediate, 60)" stroke-width="$piste_downhill_width"/>
				</rule>
			</rule>
			<!-- Captions for downhill-->
			<rule e="way" k="piste:type" v="downhill" zoom-min="15">
