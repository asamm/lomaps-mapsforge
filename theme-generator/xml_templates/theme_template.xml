				<symbol src="file:symbols/poi_junction_nlbe_hike.svg" display="always" symbol-width="${round($text_size_nlbe_junction_z14 * 1.7)}" priority="$priority_cyclo_nlbe_junction_circle"/>
				<caption k="rwn_ref" position="center" display="always" font-style="bold" font-size="$text_size_nlbe_junction_z14" fill="$color_hiking_iwn_nwn" stroke="$color_text_stroke" stroke-width="1.5" priority="$priority_cyclo_nlbe_junction_number"/>
			</rule>
			<rule e="node" k="*" v="*" zoom-min="17" zoom-max="19">
				<symbol src="file:symbols/poi_junction_nlbe_hike.svg" display="always" symbol-width="${round($text_size_nlbe_junction_z17 * 1.8)}" priority="$priority_cyclo_nlbe_junction_circle"/>
				<caption k="rwn_ref" position="center" display="always" font-style="bold" font-size="$text_size_nlbe_junction_z17" fill="$color_hiking_iwn_nwn" stroke="$color_text_stroke" stroke-width="1.5" priority="$priority_cyclo_nlbe_junction_number"/>
			</rule>
		</rule>
	</rule>

	<!-- For old maps till 2025.02.01 -->
	<rule cat="cyc_routes" e="node" k="cycle_node" v="NLBE">
		<rule e="node" k="cycle_node" v="*" zoom-min="12" zoom-max="13">
			<rule e="node" k="cycle_node" v="*">
				<symbol src="file:symbols/poi_junction_nlbe.svg" display="always" symbol-width="${round($text_size_nlbe_junction_z12 * 1.7)}" priority="$priority_cyclo_nlbe_junction_circle"/>
				<caption k="name" position="center" display="always" font-style="bold" font-size="$text_size_nlbe_junction_z12" fill="$color_cycle_text_ref" stroke="$color_text_stroke" stroke-width="1.5" priority="$priority_cyclo_nlbe_junction_number"/>
			</rule>
		</rule>
		<rule e="node" k="cycle_node" v="*" zoom-min="14" zoom-max="16">
			<rule e="node" k="cycle_node" v="*">
				<symbol src="file:symbols/poi_junction_nlbe.svg" display="always" symbol-width="${round($text_size_nlbe_junction_z14 * 1.7)}" priority="$priority_cyclo_nlbe_junction_circle"/>
				<caption k="name" position="center" display="always" font-style="bold" font-size="$text_size_nlbe_junction_z14" fill="$color_cycle_text_ref" stroke="$color_text_stroke" stroke-width="1.5" priority="$priority_cyclo_nlbe_junction_number"/>
			</rule>
		</rule>
		<rule e="node" k="cycle_node" v="*" zoom-min="17" zoom-max="19">
			<rule e="node" k="cycle_node" v="*">
				<symbol src="file:symbols/poi_junction_nlbe.svg" display="always" symbol-width="${round($text_size_nlbe_junction_z17 * 1.8)}" priority="$priority_cyclo_nlbe_junction_circle"/>
				<caption k="name" position="center" display="always" font-style="bold" font-size="$text_size_nlbe_junction_z17" fill="$color_cycle_text_ref" stroke="$color_text_stroke" stroke-width="1.5" priority="$priority_cyclo_nlbe_junction_number"/>
			</rule>
		</rule>
	</rule>

	<rule cat="hik_routes" e="node" k="hiking_node" v="NLBE">
		<rule e="node" k="hiking_node" v="*" zoom-min="12" zoom-max="13">
			<rule e="node" k="hiking_node" v="*">
				<symbol src="file:symbols/poi_junction_nlbe_hike.svg" display="always" symbol-width="${round($text_size_nlbe_junction_z12 * 1.7)}" priority="$priority_cyclo_nlbe_junction_circle"/>
				<caption k="name" position="center" display="always" font-style="bold" font-size="$text_size_nlbe_junction_z12" fill="$color_hiking_iwn_nwn" stroke="$color_text_stroke" stroke-width="1.5" priority="$priority_cyclo_nlbe_junction_number"/>
			</rule>
		</rule>
		<rule e="node" k="hiking_node" v="*" zoom-min="14" zoom-max="16">
			<rule e="node" k="hiking_node" v="*">
				<symbol src="file:symbols/poi_junction_nlbe_hike.svg" display="always" symbol-width="${round($text_size_nlbe_junction_z14 * 1.7)}" priority="$priority_cyclo_nlbe_junction_circle"/>
				<caption k="name" position="center" display="always" font-style="bold" font-size="$text_size_nlbe_junction_z14" fill="$color_hiking_iwn_nwn" stroke="$color_text_stroke" stroke-width="1.5" priority="$priority_cyclo_nlbe_junction_number"/>
