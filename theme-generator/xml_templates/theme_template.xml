		<!-- tree row -->
		<rule cat="base_summer" e="way" k="natural" v="tree_row" zoom-min="14">
			<line stroke="$opacity($color_forest_summer_orchard_z13, 50)" stroke-width="1" stroke-linecap="round"/>
