							<line stroke="$color_railway_line" stroke-width="0.6" stroke-linecap="butt"/>
							<line stroke="$color_railway_fill_light" stroke-width="0.3" stroke-linecap="butt"/>
							<line stroke="$color_railway_line" stroke-width="0.3" stroke-dasharray="12,12" stroke-linecap="butt"/>
						</rule>
					</rule>
					<!-- fallback for railways without usage and service tags -->
					<rule e="way" k="usage|service" v="~">
						<rule e="way" k="*" v="*" zoom-min="11" zoom-max="14">
							<line stroke="$color_railway_line" stroke-width="1.5" stroke-linecap="butt"/>
							<line stroke="$color_railway_fill_light" stroke-width="1.1" stroke-linecap="butt"/>
							<line stroke="$color_railway_line" stroke-width="1.1" stroke-dasharray="13,13" stroke-linecap="butt"/>
						</rule>
						<rule e="way" k="*" v="*" zoom-min="15">
							<line stroke="$color_railway_line" stroke-width="1.1" stroke-linecap="butt"/>
							<line stroke="$color_railway_fill_light" stroke-width="0.6" stroke-linecap="butt"/>
							<line stroke="$color_railway_line" stroke-width="0.6" stroke-dasharray="12,12" stroke-linecap="butt"/>
						</rule>
					</rule>
				</rule>
