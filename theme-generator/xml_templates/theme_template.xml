				</rule>
				<rule e="way" k="piste:difficulty" v="easy">
					<pathText k="name" font-style="bold" font-size="11" dy="3" fill="$color_downhill_easy_label" stroke="$color_text_stroke" stroke-width="2.5" repeat-gap="300"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="intermediate">
					<pathText k="name" font-style="bold" font-size="11" dy="3" fill="$color_downhill_intermediate_lbl" stroke="$color_text_stroke" stroke-width="2.5" repeat-gap="300"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="advanced|expert">
					<pathText k="name" font-style="bold" font-size="11" dy="3" fill="$color_road_labels_fill" stroke="$color_text_stroke" stroke-width="2.5" repeat-gap="300"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="freeride">
