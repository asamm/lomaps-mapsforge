				<rule e="way" k="railway" v="funicular" zoom-min="13" gen_section="railway_sec">
					<rule e="way" k="*" v="*" zoom-min="13" zoom-max="16">
						<line stroke="$color_railway_main_case" stroke-width="0.2" stroke-linecap="butt"/>
						<line stroke="$color_railway_main_case" stroke-width="1.5" stroke-dasharray="13,16"/>
						<line stroke="$color_railway_main" stroke-width="1" stroke-dasharray="1.3,0,12,15.7"/>
					</rule>
					<rule e="way" k="*" v="*" zoom-min="17">
						<line stroke="$color_railway_main_case" stroke-width="0.2" stroke-linecap="butt"/>
						<line stroke="$color_railway_main_case" stroke-width="1" stroke-dasharray="13,23"/>
						<line stroke="$color_railway_main" stroke-width="0.75" stroke-dasharray="1.3,0,12,22.7"/>
					</rule>
				</rule>
				<rule e="way" k="railway" v="monorail" zoom-min="13" gen_section="railway_sec">
