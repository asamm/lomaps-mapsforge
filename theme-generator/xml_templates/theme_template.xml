						<rule e="way" k="highway" v="construction">
							<line stroke="$color_area_fill_light" stroke-width="0.6"/>
							<pathText k="name" font-style="bold" font-size="15" fill="$color_highway_label_text" stroke="$color_text_stroke" stroke-width="4.0"/>
						</rule>
						<rule e="way" k="highway" v="residential|living_street|service|unclassified|road">
							<line stroke="$color_road" stroke-width="0.5"/>
						</rule>
						<rule e="way" k="highway" v="cycleway|bridleway">
							<line stroke="$color_road" stroke-width="0.2"/>
							<pathText k="name" dy="4.7" font-style="bold" font-size="10" fill="$color_highway_label_text" stroke="$color_text_stroke" stroke-width="1.5"/>
						</rule>
						<rule e="way" k="highway" v="tertiary|raceway|tertiary_link">
							<line stroke="$color_tertiary_core_hi" stroke-width="0.6"/>
						</rule>
						<rule e="way" k="highway" v="secondary_link">
							<line stroke="$color_secondary_link_core_hi" stroke-width="0.6"/>
						</rule>
						<rule e="way" k="highway" v="primary_link">
							<line stroke="$color_primary_trunk_link_core" stroke-width="0.6"/>
