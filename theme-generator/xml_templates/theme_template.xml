					<caption k="name" dy="11"  font-style="bold" font-family="sans_serif" font-size="17" fill="$color_wood_label" stroke="$color_text_stroke" stroke-width="2" text-wrap-width="$text_wrap_standard"/>
				</rule>
			</rule>
			<rule e="way" k="*" v="kindergarten|school|college|university">
				<area fill="$color_building_public_fill"/>
			</rule>
		</rule>
		<!-- sport -->
		<rule cat="no_car" e="way" k="sport" v="*" zoom-min="14">
			<!-- fill sport areas as institute areas like school, etc. -->
			<!--<area fill="$color_sport_area" />-->
		</rule>
		<!-- leisure -->
		<rule cat="base_topo" e="way" k="leisure" v="*" zoom-min="12">

			<!-- Closed Golf, playground summer -->
			<rule cat="base_summer" e="way" k="leisure" v="*" zoom-min="13" closed="yes">
				<rule e="way" k="leisure" v="stadium|sports_centre|water_park">
					<area stroke="$darken($color_landuse_residential_sum,20)" stroke-width="0.3"/>
				</rule>
				<rule e="way" k="leisure" v="golf_course|common|green">
					<area fill="$color_leisure_green_summer"/>
				</rule>
				<rule e="way" k="leisure" v="playground|playing_fields|pitch|dog_park|fitness_station|track">
					<area fill="$color_leisure_playground_sum" />
					<line stroke="$color_leisure_playground_sum_ln" stroke-width="0.15" />
				</rule>
			</rule>
			<!-- Non Closed Golf, playground summer , pumptrack -->
			<rule cat="base_summer" e="way" k="leisure" v="*" zoom-min="13" closed="no">
				<rule e="way" k="leisure" v="track" zoom-min="15">
					<line stroke="$darken($color_leisure_playground_sum_ln,10)" stroke-width="0.6" stroke-linecap="butt"/>
					<line stroke="$darken($color_leisure_playground_sum,10)" stroke-width="0.45" stroke-linecap="butt"/>
				</rule>
			</rule>

			<!-- Closed Golf, playground winter -->
			<rule cat="base_winter" e="way" k="leisure" v="*" zoom-min="13" closed="yes">
				<rule e="way" k="leisure" v="stadium|sports_centre|water_park">
					<area stroke="$color_area_fill_light" stroke-width="0.3"/>
				</rule>
				<rule e="way" k="leisure" v="golf_course|common|green">
					<area fill="$color_leisure_green_winter"/>
				</rule>
				<rule e="way" k="leisure" v="playground|playing_fields|pitch|dog_park|fitness_station|track">
					<area fill="$color_leisure_playground_win" />
					<line stroke="$color_leisure_playground_win_ln" stroke-width="0.15" />
				</rule>
			</rule>
			<!-- Non  closed leisure  -->
			<rule cat="base_winter" e="way" k="leisure" v="*" zoom-min="13" closed="no">
				<rule e="way" k="leisure" v="track">
					<line stroke="$darken($color_leisure_playground_win_ln,10)" stroke-width="0.6" stroke-linecap="butt"/>
					<line stroke="$darken($color_leisure_playground_win,10)" stroke-width="0.45" stroke-linecap="butt"/>
				</rule>
			</rule>

			<!-- Nature protected areas -->
			<rule e="way" k="leisure" v="nature_reserve" zoom-min="12">
				<line stroke="${opacity($color_national_park_case,50)}" stroke-width="0.7" stroke-dasharray="2,6" stroke-linecap="square"/>
                <rule e="any" k="*" v="*" zoom-min="16">
                    <caption k="name" dy="12" font-style="bold_italic" font-size="13" fill="$color_meadow" stroke="$color_text_stroke" stroke-width="3" position="center" priority="$priority_poi_caption_cat1" text-wrap-width="$text_wrap_standard"/>
                </rule>
			</rule>
			<!-- Marina -->
			<rule e="way" k="leisure" v="marina" zoom-min="13">
				<line stroke="$opacity($color_marina_case_outer, 40)" stroke-width="0.8" stroke-linecap="butt"/>
				<line dy="-0.3" stroke="$opacity($color_marina_case_inner, 25)" stroke-width="0.2" stroke-linecap="butt"/>
				<rule e="way" k="*" v="*" zoom-min="15">
					<caption k="name" font-style="bold_italic" font-size="13" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="2" text-wrap-width="$text_wrap_standard"/>
				</rule>
			</rule>
			<rule e="way" k="leisure" v="stadium|sports_centre|water_park|golf_course|playing_fields|pitch|" zoom-min="15">
				<caption k="name" dy="11"  font-family="sans_serif" font-size="11" fill="$color_standard_poi_text"
						 stroke="$color_text_stroke" stroke-width="2.5" text-wrap-width="$text_wrap_standard"/>
			</rule>
		</rule>
		<rule cat="base_car" e="way" k="leisure" v="*" zoom-min="13">
			<rule e="way" k="leisure" v="golf_course|common|green">
				<area fill="$color_leisure_green_summer"/>
			</rule>
			<!-- Marina -->
			<rule e="way" k="leisure" v="marina" zoom-min="13">
				<line stroke="$opacity($color_marina_case_outer, 40)" stroke-width="0.8" stroke-linecap="butt"/>
				<line dy="-0.3" stroke="$opacity($color_marina_case_inner, 25)" stroke-width="0.2" stroke-linecap="butt"/>
				<rule e="way" k="*" v="*" zoom-min="15">
					<caption k="name" font-style="bold_italic" font-size="13" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="2" text-wrap-width="$text_wrap_standard"/>
				</rule>
			</rule>
		</rule>
		<!-- Golf, playground city -->
		<rule cat="base_city" e="way" k="leisure" v="*" zoom-min="13" closed="yes">
			<rule e="way" k="leisure" v="stadium|sports_centre|water_park">
				<area fill="$color_leisure_stadium_city"/>
			</rule>
			<rule e="way" k="leisure" v="golf_course|common|green">
				<area fill="$color_leisure_green_summer"/>
			</rule>
			<rule e="way" k="leisure" v="playground|playing_fields|pitch|dog_park">
				<area fill="$color_leisure_playground_sum" stroke="$color_leisure_playground_sum_ln" stroke-width="0.1"/>
			</rule>
			<rule e="way" k="leisure" v="track">
				<rule e="way" k="area" v="yes|true">
					<area fill="$color_leisure_playground_sum" stroke="$color_leisure_playground_sum_ln" stroke-width="0.15"/>
				</rule>
			</rule>
			<!-- Marina -->
			<rule e="way" k="leisure" v="marina" zoom-min="13">
				<line stroke="$opacity($color_marina_case_outer, 40)" stroke-width="0.8" stroke-linecap="butt"/>
				<line dy="-0.3" stroke="$opacity($color_marina_case_inner, 25)" stroke-width="0.2" stroke-linecap="butt"/>
				<rule e="way" k="*" v="*" zoom-min="15">
					<caption k="name" font-style="bold_italic" font-family="serif" font-size="13" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="4" text-wrap-width="$text_wrap_standard"/>
				</rule>
			</rule>
		</rule>
		<!-- tourism areas -->
		<rule cat="base_topo" e="way" k="tourism" v="*" closed="yes">
			<rule e="way" k="tourism" v="*" zoom-min="13">
				<rule e="way" k="tourism" v="camp_site|caravan_site|attraction">
					<area fill="${opacity($color_leisure_stadium_city,60)}"/>
				</rule>
			</rule>
			<rule e="way" k="tourism" v="*" zoom-min="15">
				<rule e="way" k="tourism" v="picnic_site">
					<area fill="$color_tourism_picnic"/>
				</rule>
			</rule>
		</rule>
		<!-- end of tourism areas -->
		<!-- Contour lines  -->
		<rule cat="base_topo" e="way" k="contour_ext" v="*">
			<!-- contour lines level 13-->
			<rule e="way" k="contour_ext" v="*" zoom-min="13" zoom-max="13">
				<rule e="way" k="contour_ext" v="elevation_minor">
					<line stroke="$color_contour" stroke-width="0.20" curve="cubic"/>
				</rule>
				<rule e="way" k="contour_ext" v="elevation_major|elevation_medium">
					<line stroke="$color_contour" stroke-width="0.36" curve="cubic"/>
				</rule>
			</rule>
			<!-- contour lines level 14-15-->
			<rule e="way" k="contour_ext" v="*" zoom-min="14" zoom-max="15">
				<rule e="way" k="contour_ext" v="elevation_minor">
					<line stroke="$color_contour" stroke-width="0.16" curve="cubic"/>
				</rule>
				<rule e="way" k="contour_ext" v="elevation_major|elevation_medium">
					<line stroke="$color_contour" stroke-width="0.34" curve="cubic"/>
					<rule e="way" k="*" v="*">
						<pathText k="ele" font-style="bold" font-size="8" fill="$color_contour_label" stroke="$color_text_stroke" stroke-width="1.5" repeat-gap="200" text-orientation="left" />
					</rule>
				</rule>
			</rule>
			<!-- contour lines level 16 and above -->
			<rule e="way" k="contour_ext" v="*" zoom-min="16">
				<rule e="way" k="contour_ext" v="elevation_minor">
					<line stroke="$color_contour" stroke-width="0.11" curve="cubic"/>
				</rule>
				<rule e="way" k="contour_ext" v="elevation_major|elevation_medium">
					<line stroke="$color_contour" stroke-width="0.22" curve="cubic"/>
					<rule e="way" k="*" v="*">
						<pathText k="ele" font-style="bold" font-size="9" fill="$color_contour_label" stroke="$color_text_stroke" stroke-width="2" repeat-gap="350"  text-orientation="left"/>
					</rule>
				</rule>
			</rule>
		</rule>
		<!-- EMBANKMENT -->
		<rule cat="base_topo" e="way" k="natural" v="earth_bank" zoom-min="16">
			<line stroke="$color_railway_line" stroke-width="0.15" curve="cubic"/>
			<rule e="way" k="*" v="*" zoom-min="16" zoom-max="16">
				<line stroke="$color_railway_line" dy="0.8" stroke-width="1" stroke-dasharray="0.5,3" stroke-linecap="butt" curve="cubic"/>
			</rule>
			<rule e="way" k="*" v="*" zoom-min="17" zoom-max="17">
				<line stroke="$color_railway_line" dy="1.0" stroke-width="1" stroke-dasharray="0.5,3" stroke-linecap="butt" curve="cubic"/>
			</rule>
			<rule e="way" k="*" v="*" zoom-min="18">
				<line stroke="$color_railway_line" dy="1.3" stroke-width="1.1" stroke-dasharray="0.5,4" stroke-linecap="butt" curve="cubic"/>
			</rule>
		</rule>
		<rule cat="base_topo" e="way" k="barrier|natural" v="ditch|gully" zoom-min="15">
			<line stroke="$color_railway_line" stroke-width="0.15" curve="cubic"/>
		</rule>
		<!-- WATERS -->
		<rule e="way" k="leisure" v="swimming_pool" zoom-min="15">
			<area fill="$color_sea" stroke="$color_swimming_pool_case" stroke-width="0.1"/>
		</rule>
		<rule e="way" k="intermittent" v="~|no|false">
			<rule e="way" k="landuse|natural" v="reservoir|basin|water" zoom-min="7" >
				<rule e="way" k="ne_min_zoom" v="~" closed="yes">
					<area fill="$color_sea"/>
				</rule>
				<rule e="way" k="*" v="*" closed="no">
					<line stroke="$color_sea" stroke-width="0.25" />
				</rule>
				<rule e="way" k="*" v="*" zoom-min="14" zoom-max="15">
					<caption k="name" font-style="bold_italic" font-family="serif" font-size="11" fill="$color_water_label"
							 stroke="$color_text_stroke" stroke-width="3" priority="$priority_water_area" text-wrap-width="$text_wrap_standard"/>
				</rule>
				<rule e="way" k="*" v="*" zoom-min="16">
					<caption k="name" font-style="bold_italic" font-family="serif" font-size="12" fill="$color_water_label"
							 stroke="$color_text_stroke" stroke-width="4" priority="$priority_water_area" text-wrap-width="$text_wrap_standard"/>
				</rule>
			</rule>
		</rule>
		<!-- Intermittent water areas-->
		<rule e="way" k="intermittent" v="yes">
			<rule e="way" k="landuse|natural" v="reservoir|basin|water" zoom-min="13">
				<area src="file:${pattern_intermittent_water}" symbol-width="20"/>
			</rule>
		</rule>

		<!-- waterways -->
		<rule e="way" k="waterway" v="*">
			<!-- waterway cores -->
			<rule e="way" k="tunnel" v="~|no|false">
				<!-- standard rivers, stream, etc -->
				<rule e="way" k="intermittent" v="~|no|false">
					<rule e="way" k="waterway" v="drain|ditch">
						<line stroke="$color_sea" stroke-width="0.6"/>
					</rule>
					<rule e="way" k="waterway" v="canal">
						<rule e="way" k="*" v="*" zoom-min="9" zoom-max="12">
							<line stroke="$color_sea" stroke-width="1.1"/>
						</rule>
						<rule e="way" k="*" v="*" zoom-min="14" zoom-max="15">
							<line stroke="$color_sea" stroke-width="1"/>
							<pathText k="name" font-style="italic" font-family="serif" font-size="11" fill="$color_water_label"
									  stroke="$color_text_stroke" stroke-width="3" repeat-gap="400" priority="$priority_canal"/>
						</rule>
						<rule e="way" k="*" v="*" zoom-min="16">
							<line stroke="$color_sea" stroke-width="0.9"/>
							<pathText k="name" font-style="italic" font-family="serif" font-size="12" fill="$color_water_label"
									  stroke="$color_text_stroke" stroke-width="4" repeat-gap="400" priority="$priority_canal"/>
						</rule>
					</rule>
					<rule e="way" k="waterway" v="stream" zoom-min="12">
						<rule e="way" k="*" v="*" zoom-min="13" zoom-max="15">
							<line stroke="$color_sea" stroke-width="0.8" curve="cubic"/>
							<rule e="way" k="*" v="*" zoom-min="15" zoom-max="15">
								<pathText k="name" font-style="italic" font-family="serif"  dy="3" font-size="9" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="3" repeat-gap="400" priority="$priority_stream"/>
							</rule>
						</rule>
						<rule e="way" k="*" v="*" zoom-min="16" >
							<line stroke="$color_sea" stroke-width="0.5" curve="cubic"/>
							<pathText k="name" font-style="italic" font-family="serif" dy="2" font-size="11" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="4" repeat-gap="400" priority="$priority_stream"/>
						</rule>
					</rule>
					<rule e="way" k="waterway" v="river">
						<rule e="way" k="*" v="*" zoom-min="8" zoom-max="12"> <!-- TODO change to zoom-min to 9 after penetration of new users -->
							<line stroke="$color_sea" stroke-width="1.6"/>
						</rule>
						<rule e="way" k="*" v="*" zoom-min="13" zoom-max="14">
							<line stroke="$color_sea" stroke-width="1.4"/>
							<pathText k="name" font-style="italic" font-family="serif" font-size="11" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="3" repeat-gap="400" priority="$priority_river"/>
						</rule>
						<rule e="way" k="*" v="*" zoom-min="15" >
							<line stroke="$color_sea" stroke-width="1.3"/>
							<pathText k="name" font-style="italic" font-family="serif" font-size="14" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="4" repeat-gap="400" priority="$priority_river"/>
							<lineSymbol src="file:symbols/poi_one_way_river.svg" dy="0" symbol-orientation="left" symbol-percent="100" position="center" repeat-gap="300" repeat="true" repeat-start="30" priority="${priority_river -1}"/>
						</rule>
					</rule>
				</rule>
				<!-- Intermittent waterways -->
				<rule e="way" k="intermittent" v="yes">
					<rule e="way" k="waterway" v="drain|ditch|stream">
						<line stroke="$color_sea" stroke-width="0.3" stroke-dasharray="5,5" stroke-linecap="butt"/>
					</rule>
					<rule e="way" k="waterway" v="river|canal">
						<rule e="way" k="*" v="*" zoom-min="13">
							<rule e="way" k="*" v="*" zoom-max="15">
								<line stroke="$color_sea" stroke-width="0.6" stroke-dasharray="7,6" stroke-linecap="butt"/>
							</rule>
							<rule e="way" k="*" v="*" zoom-min="16">
								<line stroke="$color_sea" stroke-width="0.6" stroke-dasharray="10,9" stroke-linecap="butt"/>
							</rule>
							<pathText k="name" font-style="italic" font-family="serif" font-size="14" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="3" repeat-gap="400"/>
						</rule>
					</rule>
				</rule>
			</rule>
			<!-- waterway bridges-->
			<rule e="way" k="bridge" v="yes|aqueduct|movable" zoom-min="14">
				<rule e="way" k="waterway" v="ditch|drain|stream">
					<line stroke="$color_label_amenity_dark" stroke-width="0.5" stroke-linecap="butt"/>
					<line stroke="$color_sea" stroke-width="0.3" stroke-linecap="butt"/>
				</rule>
				<rule e="way" k="waterway" v="canal|river">
					<line stroke="$color_label_amenity_dark" stroke-width="1.5" stroke-linecap="butt"/>
					<line stroke="$color_sea" stroke-width="1.2" stroke-linecap="butt"/>
				</rule>
			</rule>
			<!-- waterway tunnel -->
			<rule e="way" k="tunnel" v="true|yes|culvert">
				<rule e="way" k="waterway" v="drain|ditch|stream">
					<line stroke="$color_sea" stroke-width="0.3" stroke-dasharray="1,5"/>
				</rule>
				<rule e="way" k="waterway" v="river|canal">
					<rule e="way" k="*" v="*" zoom-min="13">
						<line stroke="$color_sea" stroke-width="0.6" stroke-dasharray="1,7"/>
						<pathText k="name" font-style="italic" font-family="serif" font-size="11" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="3" repeat-gap="400" priority="$priority_river"/>
					</rule>
				</rule>
			</rule>
			<rule e="way" k="waterway" v="dock">
				<area fill="$color_sea"/>
			</rule>
			<rule e="way" k="waterway" v="riverbank" closed="yes">
				<area fill="$color_sea" stroke="$color_sea" stroke-width="0.1"/>
			</rule>
			<rule e="way" k="waterway" v="riverbank" closed="no">
				<line stroke="$color_sea" stroke-width="1"/>
			</rule>
			<rule e="way" k="waterway" v="weir">
				<line stroke="$color_railway_line" stroke-width="0.5" stroke-dasharray="0.2,2" stroke-linecap="butt"/>
				<line stroke="$color_railway_line" stroke-width="0.1"/>
			</rule>
			<rule e="way" k="waterway" v="dam" zoom-min="9">
				<area fill="$color_area_fill_light"/>
				<line stroke="${darken($color_area_fill_light, 10)}" stroke-width="0.2"/>
				<rule e="way" k="*" v="*" zoom-min="15">
					<caption k="name" dy="11"  font-style="bold" font-family="sans_serif" font-size="14" fill="$color_tourism_poi_text" stroke="$color_text_stroke" stroke-width="1.5" text-wrap-width="$text_wrap_standard"/>
				</rule>
			</rule>
		</rule>
		<!-- end of water -->

		<!-- wetland -->
		<rule cat="base_topo" e="way" k="natural|wetland" v="*" zoom-min="12">
			<rule e="way" k="wetland" v="~">
				<rule e="way" k="natural" v="wetland">
					<area src="file:${pattern_marsh}" symbol-width="28"/>
				</rule>
			</rule>
			<rule e="way" k="wetland" v="marsh|swamp|bog|fen|wet_meadow|reedbed|saltmarsh">
				<rule e="way" k="wetland" v="swamp">
					<area cat="base_summer" fill="$opacity($color_forest_summer_orchard_z13, 50)"/>
					<area cat="base_winter" fill="$opacity($color_forest_winter_z13, 50)"/>
				</rule>
				<area src="file:${pattern_marsh}" symbol-width="28"/>
			</rule>
			<rule e="way" k="wetland" v="tidalflat">
				<area fill="$opacity($color_wetland_tidalflat, 10)"/>
				<area src="file:${pattern_tidalflat}" symbol-width="96"/>
			</rule>
		</rule>
		<!-- parking areas -->
		<rule e="any" k="amenity" v="parking" zoom-min="14" closed="yes">
			<area fill="$color_parking_area" stroke="$color_unclassified_case" stroke-width="${$highway_case_z16/2}" />
		</rule>

		<!-- runways casings and areas -->
		<rule e="way" k="aeroway" v="*" zoom-min="12">
			<rule e="way" k="aeroway" v="runway">
				<area fill="$color_area_fill_light"/>
			</rule>
			<rule e="way" k="aeroway" v="*" closed="yes">
				<rule e="way" k="aeroway" v="aerodrome">
					<area fill="$opacity($color_aerodrome_area, 15)"/>
				</rule>
				<rule e="way" k="aeroway" v="taxiway">
					<area fill="$color_area_fill_light"/>
				</rule>
			</rule>
			<rule e="way" k="aeroway" v="*" closed="no">
				<rule e="way" k="aeroway" v="runway" zoom-min="9">
					<line stroke="$color_area_fill_light" stroke-width="5" stroke-linecap="square"/>
				</rule>
				<rule e="way" k="aeroway" v="taxiway" zoom-min="11">
					<line stroke="$color_area_fill_light" stroke-width="2" stroke-linecap="butt"/>
				</rule>
			</rule>
			<rule e="way" k="aeroway" v="*" closed="no">
			</rule>
			<rule e="way" k="aeroway" v="apron" zoom-min="12">
				<area fill="$color_area_fill_light"/>
			</rule>
			<rule e="way" k="aeroway" v="terminal" zoom-min="14">
				<area fill="$color_sport_area"/>
			</rule>
			<rule e="way" k="*" v="*" zoom-min="15">
				<caption k="name" font-style="italic" font-family="serif" font-size="14" fill="$color_label_amenity_dark" stroke="$color_text_stroke" stroke-width="2.5" text-wrap-width="$text_wrap_standard"/>
			</rule>
		</rule>
		<!-- military -->
		<rule e="way" k="landuse" v="military" zoom-min="9">
			<rule e="way" k="*" v="*">
				<area fill="$opacity($color_military_fill, 14.7)"/>
				<rule e="way" k="*" v="*" zoom-min="13" zoom-max="15">
					<line stroke="$opacity($color_military_fill, 55)" stroke-width="1" stroke-dasharray="9,3" stroke-linecap="butt"/>
				</rule>
				<rule e="way" k="*" v="*" zoom-min="16">
					<line stroke="$opacity($color_military_fill, 45)" stroke-width="0.8" stroke-dasharray="12,5" stroke-linecap="butt"/>
				</rule>
