						position="center" repeat="true" repeat-gap="400" repeat-start="40" />
				</rule>
		</rule>
		<!-- pistes for WINTER -->
		<rule cat="pistes" e="way" k="piste:type" v="*">
			<!-- piste areas -->
			<rule e="way" k="piste:type" v="downhill" zoom-min="13" closed="yes">
				<rule e="way" k="piste:difficulty" v="novice">
					<area fill="${opacity(lighten($color_downhill_novice, 20), 58.2)}" stroke="$opacity($color_downhill_novice, 58.2)" stroke-width="0.4"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="easy">
					<area fill="${opacity(lighten($color_downhill_easy, 20), 60)}" stroke="$opacity($color_downhill_easy, 60)" stroke-width="0.4"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="intermediate">
					<area fill="${opacity(lighten($color_downhill_intermediate, 20), 60)}" stroke="$opacity($color_downhill_intermediate, 60)" stroke-width="0.4"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="advanced|expert">
					<area fill="${opacity(lighten($color_downhill_advanced, 20), 55)}" stroke="$opacity($color_downhill_advanced, 55)" stroke-width="0.4"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="freeride">
					<area fill="${opacity(lighten($color_downhill_freeride, 20), 60)}" stroke="$opacity($color_downhill_freeride, 60)" stroke-width="0.4"/>
				</rule>
				<rule e="way" k="piste:difficulty" v="~">
					<area fill="${opacity(lighten($color_downhill_intermediate, 20), 60)}" stroke="$opacity($color_downhill_easy, 60)" stroke-width="0.4"/>
				</rule>
			</rule>
			<!-- piste ways -->
			<rule e="way" k="piste:type" v="downhill" zoom-min="13" closed="no">
