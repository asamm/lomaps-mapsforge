					<line stroke="$opacity($color_railway_tunnel_subway, 25)" stroke-width="0.5" stroke-linecap="butt"/>
					<line stroke="$opacity($color_railway_tunnel_subway, 25)" stroke-width="0.5" stroke-dasharray="8,8" stroke-linecap="butt"/>
				</rule>
				<rule e="way" k="railway" v="tram">
					<line stroke="$color_railway_tunnel_tram" stroke-width="0.1" stroke-dasharray="4,4" stroke-linecap="butt"/>
				</rule>
				<rule e="way" k="railway" v="light_rail|narrow_gauge|funicular|preserved">
