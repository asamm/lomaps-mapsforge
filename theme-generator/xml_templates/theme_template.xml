			<line stroke="$opacity($color_forest_winter_z13, 50)" stroke-width="1" stroke-linecap="round"/>
		</rule>
		<!-- Snowmobile for WINTER -->
		<rule cat="snowmobiles" e="way" k="snowmobile" v="designated" zoom-min="13">

			<rule e="way" k="ice_road" v="yes">
				<rule e="way" k="*" v="*" zoom-min="13" zoom-max="15">
					<line stroke="$opacity($color_snowmobile, 55)" stroke-width="1.7" stroke-dasharray="4,6" scale="all"/>
				</rule>
				<rule e="way" k="*" v="*" zoom-min="16" >
					<line stroke="$opacity($color_snowmobile, 55)" stroke-width="1" stroke-dasharray="2,3" scale="all"/>
				</rule>
			</rule>
			<rule e="way" k="ice_road" v="~">
				<rule e="way" k="*" v="*" zoom-max="15">
					<line stroke="$opacity($color_snowmobile, 55)" stroke-width="1.5"/>
				</rule>
				<rule e="way" k="*" v="*" zoom-min="16">
