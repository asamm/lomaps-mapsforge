<rendertheme xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/dev/resources/renderTheme.xsd" version="5"
			 base-stroke-width="0.65" map-background="$color_map_background_land" xmlns="http://mapsforge.org/renderTheme" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<stylemenu id="r4menu" defaultvalue="hike_bike" defaultlang="en">
		<!-- LAYER CITY -->
		<layer id="pub_rest_city" enabled="true" visible="false">
			<name lang="en" value="food_drink"/>
			<cat id="pub_rest_city"/>
		</layer>
		<layer id="accommodation_city" enabled="true" visible="false">
			<name lang="en" value="accommodation"/>
			<cat id="accommodation_city"/>
		</layer>
		<!-- LAYER SUMMER -->
		<layer id="cycling_routes" enabled="true" visible="false">
			<name lang="en" value="cycling_routes"/>
			<cat id="cyc_routes"/>
		</layer>
		<layer id="mtb_trails" enabled="true" visible="false">
			<name lang="en" value="mtb_trails"/>
			<cat id="cyc_mtb_routes"/>
		</layer>
		<layer id="hiking_trails" enabled="true" visible="false">
			<name lang="en" value="hiking_trails"/>
			<cat id="hik_routes"/>
		</layer>
		<layer id="via_ferrata" enabled="true" visible="false">
			<name lang="en" value="via_ferrata"/>
			<cat id="via_ferrata_cat"/>
		</layer>
		<layer id="pistes_nordic" enabled="true" visible="false">
			<name lang="en" value="nordic_ski_trails"/>
			<cat id="pistes_nordic"/>
		</layer>
		<layer id="snowmobiles" enabled="true" visible="false">
			<name lang="en" value="snowmobile_trails"/>
			<cat id="snowmobiles"/>
		</layer>
		<!-- LAYER CAR -->
		<layer id="pub_rest_car" enabled="true" visible="false">
			<name lang="en" value="food_drink"/>
			<cat id="pub_rest_car"/>
		</layer>
		<!-- CAR -->
		<layer id="car" visible="true">
			<name lang="en" value="Car"/>
			<cat id="base_car"/>
			<cat id="accommodation_car"/>
			<cat id="highways_car"/>
			<cat id="shopping"/>
			<cat id="transportation_car"/>
			<overlay id="pub_rest_car"/>
		</layer>
		<!-- CITY -->
		<layer id="city" visible="true">
			<name lang="en" value="City"/>
			<cat id="no_car"/>
			<cat id="city"/>
			<cat id="base_city"/>
			<cat id="health_city"/>
			<cat id="highways_city"/>
			<cat id="religion_city"/>
			<cat id="shopping"/>
			<cat id="tourism_city"/>
			<cat id="transportation_city"/>
			<overlay id="pub_rest_city"/>
			<overlay id="accommodation_city"/>
		</layer>
		<!-- SUMMER -->
		<layer id="hike_bike" visible="true">
			<name lang="en" value="Hike, Bike"/>
			<cat id="no_car"/>
			<cat id="base_summer"/>
			<cat id="base_topo"/>
			<cat id="accommodation_topo"/>
			<cat id="natural_topo"/>
			<cat id="highways_topo"/>
			<cat id="health_topo"/>
			<cat id="shopping"/>
			<cat id="tourism_topo"/>
			<cat id="transportation_topo"/>
			<overlay id="cycling_routes"/>
			<overlay id="mtb_trails"/>
			<overlay id="hiking_trails"/>
			<overlay id="via_ferrata"/>
			<overlay id="pub_rest_topo"/>
		</layer>
		<!-- WINTER -->
		<layer id="ski" visible="true">
			<name lang="en" value="Ski"/>
			<cat id="no_car"/>
			<cat id="base_winter"/>
			<cat id="base_topo"/>
			<cat id="accommodation_topo"/>
			<cat id="natural_topo"/>
			<cat id="highways_topo"/>
			<cat id="pistes"/>
			<cat id="health_topo"/>
			<cat id="shopping"/>
			<cat id="snowmobiles_cat"/>
			<cat id="tourism_topo"/>
			<cat id="transportation_topo"/>
			<overlay id="pub_rest_topo"/>
			<overlay id="pistes_nordic"/>
			<overlay id="snowmobiles"/>
		</layer>
	</stylemenu>

	<!-- Render sea -->
	<rule e="way" k="*" v="*">
		<rule e="way" k="natural" v="sea" >
			<area fill="$color_sea"/>
		</rule>
		<rule cat="base_car" e="way" k="natural" v="nosea">
			<area fill="$color_map_background_land"/>
		</rule>
		<rule cat="base_city" e="way" k="natural" v="nosea">
			<area fill="$color_map_background_land"/>
		</rule>
		<rule cat="base_summer" e="way" k="natural" v="nosea">
			<area fill="$color_map_background_land"/>
		</rule>
		<rule cat="base_winter" e="way" k="natural" v="nosea">
			<area fill="$color_nosea"/>
		</rule>
	</rule>


	<!-- =====================================================
				    OVERVIEW LOW ZOOMS
	====================================================== -->

	<!-- Natural landuse classification areas (class-based) -->
	<rule cat="base_topo" e="way" k="ne_landtype" v="*" closed="yes" zoom-max="4">
		<rule e="way" k="ne_landtype" v="desert">
			<area fill="$color_desert_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="flooded_grassland">
			<area fill="$color_flooded_grassland_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="grassland">
			<area fill="$color_grassland_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="ice">
			<area fill="$color_ice_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="mangrove">
			<area fill="$color_mangrove_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="mediter_forest">
			<area fill="$color_mediter_forest_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="montane_grassland">
			<area fill="$color_montane_grassland_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="savannas">
			<area fill="$color_savannas_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="taiga">
			<area fill="$color_taiga_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="tempr_conifer_forest">
			<area fill="$color_tempr_conifer_forest_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="tempr_mixed_forest">
			<area fill="$color_tempr_mixed_forest_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="trop_conif_forest">
			<area fill="$color_trop_conif_forest_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="trop_dry_forest">
			<area fill="$color_trop_dry_forest_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="trop_moist_forest">
			<area fill="$color_trop_moist_forest_z0"/>
		</rule>
		<rule e="way" k="ne_landtype" v="tundra">
			<area fill="$color_tundra_z0"/>
		</rule>
	</rule>

	<rule cat="base_topo" e="way" k="ne_landtype" v="*" closed="yes" zoom-min="5" zoom-max="5">
		<rule e="way" k="ne_landtype" v="desert">
			<area fill="${lighten($color_desert_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="flooded_grassland">
			<area fill="${lighten($color_flooded_grassland_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="grassland">
			<area fill="${lighten($color_grassland_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="ice">
			<area fill="${lighten($color_ice_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="mangrove">
			<area fill="${lighten($color_mangrove_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="mediter_forest">
			<area fill="${lighten($color_mediter_forest_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="montane_grassland">
			<area fill="${lighten($color_montane_grassland_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="savannas">
			<area fill="${lighten($color_savannas_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="taiga">
			<area fill="${lighten($color_taiga_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="tempr_conifer_forest">
			<area fill="${lighten($color_tempr_conifer_forest_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="tempr_mixed_forest">
			<area fill="${lighten($color_tempr_mixed_forest_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="trop_conif_forest">
			<area fill="${lighten($color_trop_conif_forest_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="trop_dry_forest">
			<area fill="${lighten($color_trop_dry_forest_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="trop_moist_forest">
			<area fill="${lighten($color_trop_moist_forest_z0, 45)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="tundra">
			<area fill="${lighten($color_tundra_z0, 45)}"/>
		</rule>
	</rule>

	<rule cat="base_topo" e="way" k="ne_landtype" v="*" closed="yes" zoom-min="6" zoom-max="6">
		<rule e="way" k="ne_landtype" v="desert">
			<area fill="${lighten($color_desert_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="flooded_grassland">
			<area fill="${lighten($color_flooded_grassland_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="grassland">
			<area fill="${lighten($color_grassland_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="ice">
			<area fill="${lighten($color_ice_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="mangrove">
			<area fill="${lighten($color_mangrove_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="mediter_forest">
			<area fill="${lighten($color_mediter_forest_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="montane_grassland">
			<area fill="${lighten($color_montane_grassland_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="savannas">
			<area fill="${lighten($color_savannas_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="taiga">
			<area fill="${lighten($color_taiga_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="tempr_conifer_forest">
			<area fill="${lighten($color_tempr_conifer_forest_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="tempr_mixed_forest">
			<area fill="${lighten($color_tempr_mixed_forest_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="trop_conif_forest">
			<area fill="${lighten($color_trop_conif_forest_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="trop_dry_forest">
			<area fill="${lighten($color_trop_dry_forest_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="trop_moist_forest">
			<area fill="${lighten($color_trop_moist_forest_z0, 70)}"/>
		</rule>
		<rule e="way" k="ne_landtype" v="tundra">
			<area fill="${lighten($color_tundra_z0, 70)}"/>
		</rule>
	</rule>

	<!-- NE Landuse areas -->
	<rule e="way" k="ne_landuse" v="residential" closed="yes" zoom-min="7" zoom-max="9">
		<area fill="$color_landuse_residential_ne"/>
	</rule>

	<!-- NE Water areas -->
	<rule e="way" k="ne_natural" v="water" zoom-max="9">
		<area fill="$color_sea"/>
	</rule>

	<!-- NE Rivers -->
	<rule e="way" k="ne_waterway" v="river" zoom-min="0" zoom-max="9" closed="no">
		<rule e="way" k="ne_waterway" v="river" zoom-min="0" zoom-max="4" closed="no">
		<line stroke="$color_sea" stroke-width="1.5"/>
	</rule>
		<rule e="way" k="ne_waterway" v="river" zoom-min="5" zoom-max="9" closed="no">
		<line stroke="$color_sea" stroke-width="2"/>
	</rule>
	</rule>


	<!-- NE Bathymetry -->

	<rule e="way" k="ne_bathymetry" v="yes" >
		<rule e="way" k="depth" v="0" zoom-min="0" zoom-max="5">
			<area fill="$color_sea"/>
		</rule>
		<rule e="way" k="depth" v="200" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_200"/>
		</rule>
		<rule e="way" k="depth" v="1000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_1000"/>
		</rule>
		<rule e="way" k="depth" v="2000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_2000"/>
		</rule>
		<rule e="way" k="depth" v="3000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_3000"/>
		</rule>
		<rule e="way" k="depth" v="4000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_4000"/>
		</rule>
		<rule e="way" k="depth" v="5000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_5000"/>
		</rule>
		<rule e="way" k="depth" v="6000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_6000"/>
		</rule>
		<rule e="way" k="depth" v="7000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_7000"/>
		</rule>
		<rule e="way" k="depth" v="8000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_8000"/>
		</rule>
		<rule e="way" k="depth" v="9000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_9000"/>
		</rule>
		<rule e="way" k="depth" v="10000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_10000"/>
		</rule>
		<rule e="way" k="depth" v="11000" zoom-min="0" zoom-max="5">
			<area fill="$color_ne_bathymetry_11000"/>
		</rule>
	</rule>

	<!-- NE Ocean , sea, bay names-->
	<rule e="way" k="ne_geography_marine" v="yes" closed="no">

		<rule e="way" k="type" v="ocean" zoom-min="1" zoom-max="2" >
			<pathText k="name" font-style="italic" font-family="serif" font-size="12" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="1" text-transform="uppercase" repeat-gap="600" />
		</rule>

		<rule e="way" k="rank" v="1|2|3" zoom-min="3" zoom-max="4" >
			<rule e="way" k="rank" v="1|2|3" >
				<pathText k="name" font-style="italic" font-family="serif" font-size="12" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="1" display="always" text-transform="uppercase"
					  repeat="false" repeat-gap="600" repeat-start="10" />
			</rule>
		</rule>

		<rule e="way" k="rank" v="*" zoom-min="5" zoom-max="6" >
			<rule e="way" k="rank" v="1|2|3" >
				<pathText k="name" font-style="italic" font-family="serif" font-size="16" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="1" display="always" text-transform="uppercase"
					  repeat="false" repeat-gap="600" repeat-start="10" />
			</rule>
			<rule e="way" k="rank" v="4|5|6" >
				<pathText k="name" font-style="italic" font-family="serif" font-size="12" fill="$color_water_label" stroke="$color_text_stroke" stroke-width="1" display="always" text-transform="uppercase"
					  repeat="false" repeat-gap="600" repeat-start="10" />
			</rule>
		</rule>
	</rule>

	<rule e="way" k="ne_boundary" v="administrative" >
			<rule e="way" k="admin_level" v="2" >
				<rule e="way" k="*" v="*" zoom-min="0" zoom-max="1">
					<line stroke="$color_country_border_low_z" stroke-width="0.5" stroke-linecap="round" />
                </rule>
				<rule e="way" k="*" v="*" zoom-min="2" zoom-max="6">
					<line stroke="$color_country_border_low_z" stroke-width="1" stroke-linecap="round" />
                </rule>
				<rule e="way" k="*" v="*" zoom-min="7" zoom-max="9">
					<line stroke="$color_country_border_low_z" stroke-width="2" stroke-linecap="round" />
                </rule>
			</rule>

        	<rule e="way" k="admin_level" v="4" >
				<rule e="way" k="*" v="*" zoom-min="5" zoom-max="6">
					<line stroke="$color_country_border_low_z" stroke-width="0.3" stroke-linecap="round" />
                </rule>
				<rule e="way" k="*" v="*" zoom-min="7" zoom-max="7">
					<line stroke="$color_country_border_low_z" stroke-width="0.6" stroke-linecap="round" />
                </rule>
				<rule e="way" k="*" v="*" zoom-min="8" zoom-max="9">
					<line stroke="$color_country_border_low_z" stroke-width="1" stroke-linecap="round" />
                </rule>
			</rule>
	</rule>

	<!-- OVERVIEW MAP MOTORWAY -->
	<rule e="way" k="ne_highway" v="*" zoom-min="5"	zoom-max="6">

		<rule e="way" k="ne_highway" v="motorway" zoom-min="5"	zoom-max="6">
			<line stroke="$color_road_halo_lz" stroke-width="${motorway_width_z6 + $highway_case_lowlevel/2}" stroke-linejoin="round"/>
		</rule>
		<rule e="way" k="ne_highway" v="motorway">
			<line stroke="$color_motorway_z6" stroke-width="$motorway_width_z6" stroke-linejoin="round"/>
		</rule>
	</rule>

	<rule e="way" k="highway" v="*" zoom-min="7" zoom-max="8">
		<!-- Primary and motorway case lines -->
		<rule e="way" k="highway" v="primary" zoom-min="7"	zoom-max="7">
			<line stroke="$color_road_halo_lz" stroke-width="${primary_width_z7 + $highway_case_lowlevel/2}" stroke-linejoin="round" stroke-linecap="round"/>
		</rule>
		<rule e="way" k="highway" v="motorway" zoom-min="7"	zoom-max="7">
			<line stroke="$color_road_halo_lz" stroke-width="${motorway_width_z7 + $highway_case_lowlevel/2}" stroke-linejoin="round" stroke-linecap="round"/>
		</rule>
		<!-- Primary and motorway cores -->
		<rule e="way" k="highway" v="primary">
			<line stroke="$color_primary_z7_z11" stroke-width="$primary_width_z7" stroke-linejoin="round"  stroke-linecap="round"/>
		</rule>
		<rule e="way" k="highway" v="motorway">
			<line stroke="$color_motorway_z7_z11" stroke-width="$motorway_width_z7" stroke-linejoin="round"  stroke-linecap="round"/>
		</rule>

	</rule>

	<!-- OVERVIEW MAP FERRY -->
	<rule e="way" k="ne_route" v="ferry" zoom-min="7" zoom-max="9">
		<line stroke="$color_railway_line" stroke-width="1" stroke-dasharray="15,10" stroke-linecap="butt"/>
	</rule>

	<!-- OVERVIEW MAP PLACES -->
	<rule e="any" k="ne_place" v="*" zoom-max="9">

		<!-- Country names -->
		<rule e="any" k="ne_place" v="country" zoom-min="1" zoom-max="7">
			<rule e="any" k="rank" v="1|2" zoom-min="1" zoom-max="2">
				<caption k="name" font-style="bold" text-transform="uppercase" font-size="10" fill="$color_label_poi" stroke="$color_text_stroke" stroke-width="${0.3*$text_halo}" text-wrap-width="$text_wrap_standard"/>
			</rule>
			<rule e="any" k="rank" v="1|2|3|4" zoom-min="3" zoom-max="4">
				<caption k="name" font-style="bold" text-transform="uppercase" font-size="11" fill="$color_label_poi" stroke="$color_text_stroke" stroke-width="${0.3*$text_halo}" text-wrap-width="$text_wrap_standard"/>
			</rule>
			<rule e="any" k="rank" v="*" zoom-min="5" zoom-max="5">
				<caption k="name"  font-style="bold" text-transform="uppercase" font-size="14" fill="$color_label_poi" stroke="$color_text_stroke" stroke-width="${0.25*$text_halo}" text-wrap-width="$text_wrap_standard"/>
			</rule>
			<rule e="any" k="rank" v="*" zoom-min="6" zoom-max="7">
				<caption k="name"  text-transform="uppercase" font-size="18" fill="$color_label_poi" stroke="$color_text_stroke" stroke-width="${0.25*$text_halo}"  text-wrap-width="$text_wrap_standard"/>
			</rule>
		</rule>

		<!-- City names -->
		<rule e="any" k="ne_place" v="city" zoom-min="5" zoom-max="7">
			<rule e="any" k="rank" v="1|2" zoom-min="5" zoom-max="5">
				<circle r="3" stroke="$color_barrier_circle" stroke-width="1"/>
				<rule e="any" k="capital" v="yes" >
					<caption k="name" dy="11"  text-transform="uppercase" font-family="sans_serif"  font-size="12" fill="$color_standard_poi_text"
						 stroke="$color_text_stroke" stroke-width="${0.4*$text_halo}" priority="$priority_ne_city_capital" text-wrap-width="$text_wrap_standard"/>
				</rule>
				<rule e="any" k="capital" v="~" >
					<caption k="name" dy="11" font-family="sans_serif"  font-size="11" fill="$color_standard_poi_text"
