				<line stroke="$color_man_made_cutline" stroke-width="0.3" stroke-dasharray="7,5" stroke-linecap="butt"/>
			</rule>
			<rule cat="base_topo" e="way" k="man_made" v="pipeline" zoom-min="14">
				<rule e="way" k="location" v="overground|overhead" zoom-min="14">
					<line stroke="$color_railway_line" dy="0.2" stroke-width="0.15" />
