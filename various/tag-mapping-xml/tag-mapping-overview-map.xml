	<!-- ==== OSM ORIGINAL TAGS ==== -->

	<!-- HIGHWAY TAGS -->
	<ways>
		<osm-tag key="highway" value="motorway" zoom-appear="6" mergeable="true"  min-pixel-size="0.5"/>
		<osm-tag key="highway" value="trunk" zoom-appear="6" mergeable="true" min-pixel-size="0.5"/>
		<osm-tag key="highway" value="primary" zoom-appear="7" mergeable="true" min-pixel-size="0.5"/>

		<osm-tag key="ne_highway" value="motorway" renderable="false"/>
		<osm-tag key="ne_route" value="ferry" renderable="false"/>
	</ways>

	<!-- NATURAL / WATERWAY TAGS -->
	<ways>
		<osm-tag key="natural" value="sea" zoom-appear="0" />
		<osm-tag key="natural" value="water" zoom-appear="7" min-pixel-size="9" />
	</ways>

	<!-- LANDUSE TAGS -->
	<ways>
		<osm-tag key="landuse" value="forest" zoom-appear="7" min-pixel-size="9"/>
	</ways>


